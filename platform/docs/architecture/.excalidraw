      "seed": 968460533,
      "version": 9,
      "versionNonce": 2135456149,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783737114273,
      "link": null,
      "locked": false,
      "text": "AA 55 C2 58 01 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 02 00 00 08 01 02 03 04 05 06 07 08 F9 3A\n\nMeaning:\n\nAA 55 C2 58 = sync\n01 = CAN packet type\n01 00 00 00 00 00 = device id\n00 00 00 00 = sequence\n00 00 00 00 00 00 00 00 = timestamp\n01 02 00 00 = CAN id 0x201\n08 = DLC\n01 02 03 04 05 06 07 08 = CAN data\nF9 3A = CRC16",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AA 55 C2 58 01 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 02 00 00 08 01 02 03 04 05 06 07 08 F9 3A\n\nMeaning:\n\nAA 55 C2 58 = sync\n01 = CAN packet type\n01 00 00 00 00 00 = device id\n00 00 00 00 = sequence\n00 00 00 00 00 00 00 00 = timestamp\n01 02 00 00 = CAN id 0x201\n08 = DLC\n01 02 03 04 05 06 07 08 = CAN data\nF9 3A = CRC16",
      "autoResize": true,
      "lineHeight": 1.25
    },
